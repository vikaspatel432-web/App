// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           Role
  clientOrgId    String?
  clientOrg      ClientOrg?     @relation(fields: [clientOrgId], references: [id])
  createdAt      DateTime       @default(now())
  issuesCreated  Issue[]        @relation("IssueCreatedBy")
  issuesAssigned Issue[]        @relation("IssueAssignee")
  issueComments  IssueComment[]
}

enum IssueStatus {
  OPEN
  READY_FOR_REVIEW
  DONE
}

enum IssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
}

model Issue {
  id               String         @id @default(cuid())
  speckleProjectId String
  speckleModelId   String
  title            String
  description      String?
  status           IssueStatus    @default(OPEN)
  priority         IssuePriority  @default(NONE)
  dueDate          DateTime?
  // Speckle object the issue is pinned to, and a serialized camera view for restoring context.
  objectId         String?
  cameraView       String?
  createdById      String
  createdBy        User           @relation("IssueCreatedBy", fields: [createdById], references: [id])
  assigneeId       String?
  assignee         User?          @relation("IssueAssignee", fields: [assigneeId], references: [id])
  comments         IssueComment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([speckleProjectId, speckleModelId])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model ClientOrg {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  logoUrl       String?
  primaryColor  String?
  users         User[]
  projectAccess ProjectAccess[]
  createdAt     DateTime        @default(now())
}

model ProjectAccess {
  id               String    @id @default(cuid())
  clientOrgId      String
  clientOrg        ClientOrg @relation(fields: [clientOrgId], references: [id], onDelete: Cascade)
  speckleProjectId String
  label            String?
  createdAt        DateTime  @default(now())

  @@unique([clientOrgId, speckleProjectId])
}
